{
  "expo": {
    "name": "IRON IQ",
    "slug": "iron-iq",
    "scheme": "ironiq",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ironiq.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.ironiq.app"
    }
  }
}